# ---------------------------------------------------------------------------
# Git attributes for Knight Survivors (Unity)
#
# Big binary files (textures, models, audio, video) are stored with Git LFS
# (Large File Storage) so the repo stays small and fast to clone.
# Everyone who clones the repo needs Git LFS installed ONCE on their machine:
#     git lfs install
# (Git LFS ships with Git for Windows and GitHub Desktop.)
# ---------------------------------------------------------------------------

# Default: let git detect text files and normalise line endings.
* text=auto

# Unity text assets: use Unity's YAML merge tool if configured, never LFS.
*.unity    text merge=unityyamlmerge eol=lf
*.prefab   text merge=unityyamlmerge eol=lf
*.asset    text merge=unityyamlmerge eol=lf
*.mat      text merge=unityyamlmerge eol=lf
*.anim     text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta     text merge=unityyamlmerge eol=lf
*.physicMaterial text merge=unityyamlmerge eol=lf
*.inputactions text eol=lf
*.asmdef   text eol=lf
*.cs       text diff=csharp
*.shader   text
*.hlsl     text
*.json     text
*.md       text

# --- Images ---------------------------------------------------------------
*.psd  filter=lfs diff=lfs merge=lfs -text
*.psb  filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
